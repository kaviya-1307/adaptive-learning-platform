# =====================================================================
# Adaptive Learning Platform - Backend Environment Template
# =====================================================================
# Copy this file to .env and fill in values appropriate for your environment.
# DO NOT commit real secrets, passwords, or production credentials to Git.

# Database Configuration (MySQL 8.0+)
# Local format:  mysql+pymysql://<user>:<password>@localhost:3306/<dbname>
# Cloud format:  mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>?ssl_verify_cert=true
DATABASE_URL=mysql+pymysql://db_user:db_password@localhost:3306/adaptive_learning

# Application Environment
PROJECT_NAME="LeetCode Adaptive Learning Platform"
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Security & JWT Tokens
# Generate a secure 64-char key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_secret_key_minimum_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (JSON array format)
# Include frontend development and production URLs
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Platform Initial Administrator (Optional - auto-seeded if both email and password are provided)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_admin_password
ADMIN_NAME=Platform Administrator
