    "title": "Find the first natural number whose factorial is divisible by x",
    "fn_name": "first_Factorial_Divisible_Number",
    "ref_py": "def first_Factorial_Divisible_Number(x): \r\n    i = 1;\r\n    fact = 1; \r\n    for i in range(1,x): \r\n        fact = fact * i \r\n        if (fact % x == 0): \r\n            break\r\n    return i",
