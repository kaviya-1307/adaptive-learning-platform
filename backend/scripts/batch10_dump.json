    "id": 555,
    "title": "Find sum of product of binomial co-efficients",
    "fn_name": "sum_Of_product",
    "ref_py": "def binomial_Coeff(n,k): \r\n    C = [0] * (k + 1); \r\n    C[0] = 1; # nC0 is 1 \r\n    for i in range(1,n + 1):  \r\n        for j in range(min(i, k),0,-1): \r\n            C[j] = C[j] + C[j - 1]; \r\n    return C[k]; \r\ndef sum_Of_product(n): \r\n    return binomial_Coeff(2 * n,n - 1);",
    "test_cases": [
      {
        "input": {
          "n": 3
