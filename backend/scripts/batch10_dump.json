  {
    "id": 520,
    "title": "Find the maximum element in a sorted and rotated array",
    "fn_name": "find_Max",
    "ref_py": "def find_Max(arr,low,high): \r\n    if (high < low): \r\n        return arr[0] \r\n    if (high == low): \r\n        return arr[low] \r\n    mid = low + (high - low) // 2 \r\n    if (mid < high and arr[mid + 1] < arr[mid]): \r\n        return arr[mid] \r\n    if (mid > low and arr[mid] < arr[mid - 1]): \r\n        return arr[mid - 1]  \r\n    if (arr[low] > arr[mid]): \r\n        return find_Max(arr,low,mid - 1) \r\n    else: \r\n        return find_Max(arr,mid + 1,high)",
    "test_cases": [
      {
        "input": {
          "arr": [
            2,
            3,
            5,
            6,
            9
          ],
          "low": 0,
          "high": 4
        },
        "output": 9
      },
      {
        "input": {
          "arr": [
            3,
            4,
            5,
            2,
            1
          ],
          "low": 0,
          "high": 4
        },
        "output": 5
      },
      {
        "input": {
          "arr": [
            1,
            2,
            3
          ],
          "low": 0,
          "high": 2
        },
        "output": 3
      }
    ]
